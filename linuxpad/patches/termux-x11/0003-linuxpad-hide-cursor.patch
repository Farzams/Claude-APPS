+// LinuxPad: touch input draws its own pointer (a ring in the Android view), so the X cursor can be hidden while a finger is used.
+static volatile int linuxpadCursorHidden = 0;
+void rendererSetCursorHidden(__unused JNIEnv *env, __unused jobject self, jboolean hidden) {
+    linuxpadCursorHidden = hidden ? 1 : 0;
+}
